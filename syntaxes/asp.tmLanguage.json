{
    "name": "Classic ASP",
    "scopeName": "text.html.asp",
    "comment": "Classic ASP with HTML (SQL Highlighting in Strings)",
    "fileTypes": [
        "asp",
        "asa"
    ],
    "foldingStartMarker": "(?i)^\\s*(Public|Private)?\\s*(Class|Function|Sub|Property)\\s*([a-zA-Z_]\\w*)\\s*(\\(.*\\)\\s*)?$",
    "foldingStopMarker": "(?i)^\\s*End (Class|Function|Sub|Property)\\s*$",
    "injections": {
        "text.html.asp - (meta.embedded | meta.tag | comment.block.html), L:((text.html.asp meta.tag) - (meta.embedded.block.asp | meta.embedded.line.asp)), L:(source.js - (meta.embedded.block.asp | meta.embedded.line.asp)), L:(source.css - (meta.embedded.block.asp | meta.embedded.line.asp))": {
            "patterns": [
                {
                    "include": "#asp-tag"
                }
            ]
        }
    },
    "patterns": [
        {
            "include": "#vbscript-script-tag"
        },
        {
            "include": "text.html.derivative"
        }
    ],
    "repository": {
        "vbscript-script-tag": {
            "patterns": [
                {
                    "comment": "Server/client VBScript: language=\"vbscript\" (quoted or unquoted) OR type=\"...vbscript\" (e.g. text/vbscript). Mirrors isVbScriptTag/getZone.",
                    "name": "meta.embedded.block.asp",
                    "begin": "(?i)(<script\\b(?=[^>]*(?:\\blanguage\\s*=\\s*[\"']?vbscript\\b|\\btype\\s*=\\s*[\"'][^\"']*vbscript))[^>]*>)",
                    "end": "(?i)(</script\\s*>)",
                    "contentName": "source.vbscript.embedded.asp",
                    "beginCaptures": {
                        "1": {
                            "patterns": [{ "include": "text.html.derivative" }]
                        }
                    },
                    "endCaptures": {
                        "1": {
                            "patterns": [{ "include": "text.html.derivative" }]
                        }
                    },
                    "patterns": [
                        {
                            "include": "#vbscript-code"
                        }
                    ]
                }
            ]
        },
        "asp-tag": {
            "patterns": [
                {
                    "comment": "ASP output block <%=",
                    "name": "meta.embedded.line.asp",
                    "begin": "<%=",
                    "end": "%>",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.section.embedded.begin.asp"
                        }
                    },
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.section.embedded.end.asp"
                        }
                    },
                    "contentName": "source.asp",
                    "patterns": [
                        {
                            "include": "#vbscript-code"
                        }
                    ],
                    "applyEndPatternLast": 1
                },
                {
                    "comment": "ASP code block <%",
                    "name": "meta.embedded.block.asp",
                    "begin": "<%",
                    "end": "%>",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.section.embedded.begin.asp"
                        }
                    },
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.section.embedded.end.asp"
                        }
                    },
                    "contentName": "source.asp",
                    "patterns": [
                        {
                            "include": "#vbscript-code"
                        }
                    ],
                    "applyEndPatternLast": 1
                }
            ]
        },
        "vbscript-code": {
            "patterns": [
                {
                    "include": "#comments"
                },
                {
                    "include": "#strings"
                },
                {
                    "include": "#function-declaration"
                },
                {
                    "include": "#keywords"
                },
                {
                    "include": "#constants"
                },
                {
                    "include": "#asp-objects"
                },
                {
                    "include": "#com-members"
                },
                {
                    "include": "#operators"
                },
                {
                    "include": "#numbers"
                },
                {
                    "include": "#functions"
                }
            ]
        },
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.apostrophe.asp",
                    "begin": "(^[ \\t]+)?(?=')",
                    "beginCaptures": {
                        "1": {
                            "name": "punctuation.whitespace.comment.leading.asp"
                        }
                    },
                    "end": "(?!\\G)",
                    "patterns": [
                        {
                            "name": "comment.line.apostrophe.asp",
                            "begin": "'",
                            "beginCaptures": {
                                "0": {
                                    "name": "punctuation.definition.comment.asp"
                                }
                            },
                            "end": "(?=%>)|\\n"
                        }
                    ]
                },
                {
                    "name": "comment.line.rem.asp",
                    "begin": "(^[ \\t]+)?(?i:(?=REM ))",
                    "beginCaptures": {
                        "1": {
                            "name": "punctuation.whitespace.comment.leading.asp"
                        }
                    },
                    "end": "(?!\\G)",
                    "patterns": [
                        {
                            "name": "comment.line.rem.asp",
                            "begin": "(?i:REM )",
                            "beginCaptures": {
                                "0": {
                                    "name": "punctuation.definition.comment.asp"
                                }
                            },
                            "end": "(?=%>)|\\n"
                        }
                    ]
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "comment": "All double-quoted strings. SQL keyword colouring is excluded here to prevent false positives. Confirmed SQL strings are coloured via semantic tokens in aspSemanticProvider.ts instead.",
                    "name": "string.quoted.double.asp",
                    "begin": "\"",
                    "end": "\"(?!\")",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.begin.asp"
                        }
                    },
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.end.asp"
                        }
                    },
                    "patterns": [
                        {
                            "name": "constant.character.escape.apostrophe.asp",
                            "match": "\"\""
                        }
                    ]
                }
            ]
        },
        "function-declaration": {
            "patterns": [
                {
                    "name": "meta.function.asp",
                    "match": "(?i)^\\s*(function|sub)\\s+([a-zA-Z_]\\w*)\\s*(\\()([^)]*)(\\))[^'\\r\\n]*",
                    "captures": {
                        "1": {
                            "name": "storage.type.function.asp"
                        },
                        "2": {
                            "name": "entity.name.function.asp"
                        },
                        "3": {
                            "name": "punctuation.definition.parameters.asp"
                        },
                        "4": {
                            "name": "variable.parameter.function.asp",
                            "patterns": [
                                {
                                    "include": "#parameter-modifiers"
                                }
                            ]
                        },
                        "5": {
                            "name": "punctuation.definition.parameters.asp"
                        }
                    }
                }
            ]
        },
        "parameter-modifiers": {
            "comment": "ByRef/ByVal, reached both on their own and from inside a declaration's parameter list",
            "patterns": [
                {
                    "name": "storage.modifier.asp",
                    "match": "(?i)\\b(ByRef|ByVal)\\b"
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.asp",
                    "match": "(?i)\\b(If|Then|Else|ElseIf|End\\s+If|While|Wend|For|To|Each|In|Step|Case|Select|End\\s+Select|Do|Until|Loop|Next|With|End\\s+With|Exit\\s+Do|Exit\\s+For|Exit\\s+Function|Exit\\s+Property|Exit\\s+Sub|GoTo|Stop)\\b"
                },
                {
                    "name": "storage.type.asp",
                    "match": "(?i)\\b(Call|Class|Const|Dim|ReDim|Preserve|Erase|Function|Sub|Property|End\\s+Property|End\\s+Sub|End\\s+Function|End\\s+Class|Set|Let|Get|New|Randomize|Option\\s+Explicit|On\\s+Error\\s+Resume\\s+Next|On\\s+Error\\s+GoTo)\\b"
                },
                {
                    "name": "storage.modifier.asp",
                    "match": "(?i)\\b(Private|Public|Default)\\b"
                },
                {
                    "comment": "Me is the current instance inside a Class, not a declared variable",
                    "name": "variable.language.asp",
                    "match": "(?i)\\b(Me)\\b"
                },
                {
                    "name": "keyword.operator.logical.asp",
                    "match": "(?i)\\b(And|Or|Not|Xor|Eqv|Imp|Is)\\b"
                },
                {
                    "include": "#parameter-modifiers"
                }
            ]
        },
        "constants": {
            "patterns": [
                {
                    "name": "constant.language.asp",
                    "match": "(?i)\\b(Empty|False|Nothing|Null|True)\\b"
                },
                {
                    "name": "support.type.vb.asp",
                    "match": "(?i)\\b(vbArray|vbBinaryCompare|vbBoolean|vbByte|vbCr|vbCrLf|vbCurrency|vbDataObject|vbDate|vbDecimal|vbDouble|vbEmpty|vbError|vbFalse|vbFirstFourDays|vbFirstFullWeek|vbFirstJan1|vbFormFeed|vbFriday|vbGeneralDate|vbInteger|vbLf|vbLong|vbLongDate|vbLongTime|vbMonday|vbNewLine|vbNull|vbNullChar|vbNullString|vbObject|vbObjectError|vbSaturday|vbShortDate|vbShortTime|vbSingle|vbString|vbSunday|vbTab|vbTextCompare|vbThursday|vbTrue|vbTuesday|vbUseDefault|vbUseSystemDayOfWeek|vbVariant|vbVerticalTab|vbWednesday)\\b"
                }
            ]
        },
        "asp-objects": {
            "patterns": [
                {
                    "comment": "ASP object.method or object.property pattern - must come first",
                    "name": "meta.object-access.asp",
                    "match": "(?i)\\b(Application|ASPError|Err|ObjectContext|Request|Response|Server|Session)\\b\\.(\\w+)",
                    "captures": {
                        "1": {
                            "name": "support.class.asp"
                        },
                        "2": {
                            "name": "support.function.asp"
                        }
                    }
                },
                {
                    "name": "support.class.asp",
                    "match": "(?i)\\b(Application|ASPError|Err|ObjectContext|Request|Response|Server|Session)\\b"
                },
                {
                    "name": "support.class.collection.asp",
                    "match": "(?i)(?<=\\.)\\b(ClientCertificate|Contents|Cookies|Form|QueryString|ServerVariables|StaticObjects)\\b"
                },
                {
                    "name": "support.constant.asp",
                    "match": "(?i)(?<=\\.)\\b(ASPCode|ASPDescription|Buffer|CacheControl|Category|Charset|CodePage|Column|ContentType|Description|Expires|ExpiresAbsolute|File|HelpContext|HelpFile|IsClientConnected|LCID|Line|Number|PICS|ScriptTimeout|SessionID|Source|Status|Timeout|TotalBytes)\\b"
                },
                {
                    "name": "support.function.asp",
                    "match": "(?i)(?<=\\.)\\b(Abandon|AddHeader|AppendToLog|BinaryRead|BinaryWrite|Clear|CreateObject|End|Execute|Flush|GetLastError|HTMLEncode|Lock|MapPath|Raise|Redirect|SetAbort|SetComplete|Transfer|Unlock|URLEncode|Write)\\b"
                },
                {
                    "name": "support.function.event.asp",
                    "match": "(?i)\\b(Application_OnEnd|Application_OnStart|OnTransactionAbort|OnTransactionCommit|Session_OnEnd|Session_OnStart|Class_Initialize|Class_Terminate)\\b"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.asp",
                    "match": "=|>=|<=|<>|<|>|\\+|-|\\*|/|\\\\|\\^|&|(?i)\\b(Mod)\\b"
                },
                {
                    "comment": "Parentheses and square brackets — gives them bracket-pair colours in VBScript",
                    "name": "punctuation.bracket.asp",
                    "match": "[()\\[\\]]"
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.asp",
                    "match": "\\b((0(x|X)[0-9a-fA-F]*)|(([0-9]+\\.?[0-9]*)|(\\.[0-9]+))((e|E)(\\+|-)?[0-9]+)?)(L|l|UL|ul|u|U|F|f)?\\b"
                }
            ]
        },
        "functions": {
            "patterns": [
                {
                    "name": "support.function.vb.asp",
                    "match": "(?i)\\b(Abs|Array|Asc|AscB|AscW|Atn|CBool|CByte|CCur|CDate|CDbl|Chr|ChrB|ChrW|CInt|CLng|Cos|CreateObject|CSng|CStr|Date|DateAdd|DateDiff|DatePart|DateSerial|DateValue|Day|Escape|Eval|Execute|ExecuteGlobal|Exp|Filter|Fix|FormatCurrency|FormatDateTime|FormatNumber|FormatPercent|GetLocale|GetObject|GetRef|Hex|Hour|InputBox|InStr|InStrB|InStrRev|Int|IsArray|IsDate|IsEmpty|IsNull|IsNumeric|IsObject|Join|LBound|LCase|Left|LeftB|Len|LenB|LoadPicture|Log|LTrim|Mid|MidB|Minute|Month|MonthName|MsgBox|Now|Oct|Replace|RGB|Right|RightB|Rnd|Round|RTrim|ScriptEngine|ScriptEngineBuildVersion|ScriptEngineMajorVersion|ScriptEngineMinorVersion|Second|SetLocale|Sgn|Sin|Space|Split|Sqr|StrComp|String|StrReverse|Tan|Time|Timer|TimeSerial|TimeValue|Trim|TypeName|UBound|UCase|Unescape|VarType|Weekday|WeekdayName|Year)\\b"
                }
            ]
        },
        "com-members": {
            "comment": "COM object members accessed via dot notation — covers ADODB.Recordset, ADODB.Connection, ADODB.Command, Scripting.Dictionary, Scripting.FileSystemObject, MSXML2, WScript.Shell. All share one colour (support.function.com.asp) so themes treat them consistently.",
            "patterns": [
                {
                    "comment": "Matches the member name after any dot, e.g. rs.EOF, conn.Execute, dict.Add. Only the member after the dot gets this colour.",
                    "name": "support.function.com.asp",
                    "match": "(?i)(?<=\\.)\\b(Abort|AbsolutePage|AbsolutePosition|ActiveConnection|ActualSize|Add|AddAttachment|AddNew|AppActivate|AppendChild|AppendChunk|Async|AtEndOfLine|AtEndOfStream|AttachFile|Attachments|AttachURL|Attributes|AvailableSpace|BaseName|Bcc|BeginTrans|Body|BodyFormat|BodyPart|BOF|Bookmark|BuildPath|CacheSize|Cancel|CancelUpdate|Cc|Charset|ChildNodes|CloneNode|Close|Column|CommandText|CommandTimeout|CommandType|CommitTrans|CompareMode|Configuration|ConnectionString|ConnectionTimeout|ContentBase|ContentLocation|Copy|CopyFile|CopyFolder|CopyTo|Count|CreateAttribute|CreateCDATASection|CreateElement|CreateFolder|CreateMHTMLBody|CreateNode|CreateParameter|CreateShortcut|CreateTextFile|CreateTextNode|CurrentDirectory|CursorLocation|CursorType|DateCreated|DateLastAccessed|DateLastModified|DefaultDatabase|DefinedSize|Delete|DeleteFile|DeleteFolder|Description|Direction|DocumentElement|Drive|DriveExists|DriveLetter|Drives|DriveType|EditMode|Environment|EOF|EOS|Errors|Exec|Execute|Exists|ExpandEnvironmentStrings|Fields|FileExists|Files|FileSystem|Filter|FirstChild|Flush|FolderExists|FreeSpace|From|GetAbsolutePathName|GetAllResponseHeaders|GetAttribute|GetBaseName|GetChunk|GetDrive|GetDriveName|GetExtensionName|GetFile|GetFileName|GetFolder|GetParentFolderName|GetResponseHeader|GetRows|GetSpecialFolder|GetStream|GetString|GetTempName|HasChildNodes|HelpContext|HelpFile|HTMLBody|Importance|InsertBefore|IsolationLevel|IsReady|IsRootFolder|Item|Items|Key|Keys|LastChild|Length|Line|LineSeparator|Load|LoadFromFile|LoadXML|LockType|LogEvent|MailFormat|MaxRecords|MimeFormatted|Mode|Move|MoveFile|MoveFirst|MoveFolder|MoveLast|MoveNext|MovePrevious|Name|NamespaceURI|NativeError|NextNode|NextRecordset|NextSibling|NodeName|NodeType|NodeValue|Number|NumericScale|Open|OpenAsTextStream|OpenSchema|OpenTextFile|Organization|OriginalValue|OwnerDocument|PageCount|PageSize|Parameters|ParentFolder|ParentNode|ParseError|Path|Popup|Position|Precision|Prepared|PreserveWhiteSpace|PreviousSibling|Properties|Provider|Read|ReadAll|ReadLine|ReadText|ReadyState|RecordCount|RegDelete|RegRead|RegWrite|Remove|RemoveAll|RemoveChild|ReplaceChild|ReplyTo|Requery|Reset|ResolveExternals|ResponseBody|ResponseStream|ResponseText|ResponseXML|RollbackTrans|RootFolder|Run|Save|SaveToFile|SelectNodes|SelectSingleNode|Send|Sender|SendKeys|SerialNumber|SetAttribute|SetEOS|SetOption|SetProperty|SetRequestHeader|SetTimeouts|ShareName|ShortName|ShortPath|Size|Skip|SkipLine|Sort|Source|SpecialFolders|SQLState|State|Status|StatusText|SubFolders|Subject|Supports|Text|TextBody|To|TotalSize|TransformNode|Type|UnderlyingValue|Update|UpdateBatch|ValidateOnParse|Value|Version|VolumeName|WaitForResponse|Write|WriteBlankLines|WriteLine|WriteText|XML)\\b"
                }
            ]
        }
    }
}