{
    "name": "classic-asp-language-support",
    "displayName": "Classic ASP Language Support",
    "description": "Formatting, IntelliSense, Auto-Completion, and Syntax Highlighting for Classic ASP files with HTML, CSS, JavaScript, SQL, and VBScript.",
    "version": "0.6.4",
    "icon": "images/icon.png",
    "publisher": "ashtonckj",
    "repository": {
        "type": "git",
        "url": "https://github.com/ashtonckj/Classic-ASP-Language-Support.git"
    },
    "sponsor": {
        "url": "https://github.com/ashtonckj/Classic-ASP-Language-Support.git"
    },
    "engines": {
        "vscode": "^1.80.0"
    },
    "categories": [
        "Programming Languages",
        "Formatters",
        "Snippets",
        "Other"
    ],
    "keywords": [
        "ASP",
        "Classic",
        "Classic ASP",
        "Active Server Pages",
        "VBScript",
        "HTML",
        "CSS",
        "JavaScript",
        "SQL",
        "Syntax Highlighting",
        "Formatter",
        "Intellisense",
        "Autocomplete",
        "Snippets"
    ],
    "license": "MIT",
    "activationEvents": [
        "onLanguage:asp"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "languages": [
            {
                "id": "asp",
                "aliases": [
                    "Classic ASP",
                    "ASP",
                    "asp"
                ],
                "extensions": [
                    ".asp",
                    ".inc"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "asp",
                "scopeName": "text.html.asp",
                "path": "./syntaxes/asp.tmLanguage.json",
                "embeddedLanguages": {
                    "text.html.asp": "html",
                    "source.asp": "asp",
                    "source.css": "css",
                    "source.js": "javascript"
                }
            }
        ],
        "semanticTokenScopes": [
            {
                "language": "asp",
                "scopes": {
                    "function": [
                        "entity.name.function.asp"
                    ],
                    "function.declaration": [
                        "entity.name.function.asp"
                    ],
                    "namespace": [
                        "entity.name.function.asp"
                    ],
                    "namespace.declaration": [
                        "entity.name.function.asp"
                    ],
                    "variable": [
                        "variable.other.asp"
                    ],
                    "variable.declaration": [
                        "variable.other.asp"
                    ],
                    "parameter": [
                        "variable.parameter.function.asp"
                    ],
                    "parameter.declaration": [
                        "variable.parameter.function.asp"
                    ],
                    "enumMember": [
                        "variable.other.constant.asp"
                    ],
                    "enumMember.declaration.readonly": [
                        "variable.other.constant.asp"
                    ],
                    "enumMember.readonly": [
                        "variable.other.constant.asp"
                    ],
                    "sqlDml": [
                        "keyword.other.DML.sql"
                    ],
                    "sqlDdl": [
                        "keyword.other.DDL.sql"
                    ],
                    "sqlLogical": [
                        "keyword.operator.logical.sql"
                    ],
                    "sqlKeyword": [
                        "keyword.other.sql"
                    ],
                    "sqlFunction": [
                        "support.function.aggregate.sql"
                    ],
                    "sqlType": [
                        "storage.type.sql"
                    ],
                    "sqlVariable": [
                        "variable.parameter.sql"
                    ],
                    "sqlNumber": [
                        "constant.numeric.sql"
                    ],
                    "sqlBracketPunct": [
                        "constant.numeric.sql"
                    ],
                    "sqlBracketContent": [
                        "entity.name.type.class.sql"
                    ],
                    "sqlTable": [
                        "variable.other.table.sql"
                    ],
                    "sqlColumn": [
                        "variable.other.column.sql"
                    ]
                }
            }
        ],
        "snippets": [
            {
                "language": "asp",
                "path": "./snippets/html.json"
            },
            {
                "language": "asp",
                "path": "./snippets/asp.json"
            },
            {
                "language": "asp",
                "path": "./snippets/javascript.json"
            }
        ],
        "keybindings": [
            {
                "command": "asp.insertLineBreak",
                "key": "enter",
                "when": "editorTextFocus && editorLangId == asp && !editorHasSelection && !suggestWidgetVisible && !renameInputVisible && !inSnippetMode"
            },
            {
                "command": "asp.insertTab",
                "key": "tab",
                "when": "editorTextFocus && !editorReadonly && editorLangId == asp && !suggestWidgetVisible && !editorHasSelection && !inlineSuggestionVisible && !inlineEditIsVisible && !tabShouldAcceptInlineEdit && !tabShouldJumpToInlineEdit"
            }
        ],
        "commands": [
            {
                "command": "classicAsp.previewFormatting",
                "title": "Preview Formatting",
                "category": "Classic ASP"
            }
        ],
        "menus": {
            "commandPalette": [
                {
                    "command": "classicAsp.previewFormatting",
                    "when": "editorLangId == asp"
                }
            ]
        },
        "configuration": [
            {
                "title": "VBScript Formatting",
                "properties": {
                    "classicAsp.keywordCase": {
                        "type": "string",
                        "default": "PascalCase",
                        "enum": [
                            "lowercase",
                            "UPPERCASE",
                            "PascalCase"
                        ],
                        "enumDescriptions": [
                            "if, then, end if, dim",
                            "IF, THEN, END IF, DIM",
                            "If, Then, End If, Dim"
                        ],
                        "description": "VBScript keyword casing style"
                    },
                    "classicAsp.aspTagsOnSameLine": {
                        "type": "boolean",
                        "default": false,
                        "description": "Keep <% and %> on the same line as the code they wrap"
                    },
                    "classicAsp.htmlIndentMode": {
                        "type": "string",
                        "default": "continuation",
                        "enum": [
                            "flat",
                            "continuation"
                        ],
                        "enumDescriptions": [
                            "The <% and %> delimiters sit at column 0 whatever the HTML nesting depth, and the VBScript inside is indented from there. This is the older Classic ASP convention and keeps deeply nested pages from pushing code far to the right.",
                            "The <% and %> delimiters sit at the indent of the HTML around them, so a block reads as part of the markup it is nested in. This is the default."
                        ],
                        "description": "Where the <% and %> delimiters sit relative to the surrounding HTML. The VBScript inside the block is indented the same either way — only the delimiters move."
                    },
                    "classicAsp.virtualRoot": {
                        "type": "string",
                        "default": "",
                        "description": "Absolute path to your IIS web application root, used to resolve #include virtual=\"...\" directives. Leave empty to use the workspace folder root (the default, which works for most projects)."
                    },
                    "classicAsp.defaultIncludes": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "default": [],
                        "description": "Files that are always added to IntelliSense, hover, Go to Definition, and Peek Definition for every document — even if that document has no #include for them. Use this when common libraries are only pulled in through a shared bootstrap/layout page at runtime rather than directly by each module. Paths are resolved the same way as #include virtual=\"...\" (relative to classicAsp.virtualRoot, or the workspace folder root)."
                    }
                }
            },
            {
                "title": "HTML, CSS & JavaScript Formatting (via Prettier)",
                "properties": {
                    "classicAsp.prettier.printWidth": {
                        "type": "number",
                        "default": 80,
                        "description": "Wrap lines at this column width — Prettier printWidth"
                    },
                    "classicAsp.prettier.tabWidth": {
                        "type": "number",
                        "default": 2,
                        "enum": [
                            2,
                            4,
                            8
                        ],
                        "description": "Spaces per HTML/CSS/JS indentation level — Prettier tabWidth"
                    },
                    "classicAsp.prettier.useTabs": {
                        "type": "boolean",
                        "default": false,
                        "description": "Use tabs instead of spaces for HTML/CSS/JS — Prettier useTabs"
                    },
                    "classicAsp.prettier.bracketSameLine": {
                        "type": "boolean",
                        "default": false,
                        "description": "Put the closing > of a multi-line HTML element on the last attribute line — Prettier bracketSameLine"
                    },
                    "classicAsp.prettier.semi": {
                        "type": "boolean",
                        "default": true,
                        "description": "Add semicolons at the end of JavaScript statements — Prettier semi"
                    },
                    "classicAsp.prettier.singleQuote": {
                        "type": "boolean",
                        "default": false,
                        "description": "Use single quotes instead of double quotes in JavaScript — Prettier singleQuote"
                    },
                    "classicAsp.prettier.arrowParens": {
                        "type": "string",
                        "default": "always",
                        "enum": [
                            "always",
                            "avoid"
                        ],
                        "enumDescriptions": [
                            "(x) => x",
                            "x => x"
                        ],
                        "description": "Parentheses around single arrow function parameters — Prettier arrowParens"
                    },
                    "classicAsp.prettier.trailingComma": {
                        "type": "string",
                        "default": "es5",
                        "enum": [
                            "none",
                            "es5",
                            "all"
                        ],
                        "enumDescriptions": [
                            "No trailing commas",
                            "Trailing commas where valid in ES5 (objects, arrays)",
                            "Trailing commas wherever possible"
                        ],
                        "description": "Trailing comma style — Prettier trailingComma"
                    },
                    "classicAsp.prettier.endOfLine": {
                        "type": "string",
                        "default": "auto",
                        "enum": [
                            "auto",
                            "lf",
                            "crlf",
                            "cr"
                        ],
                        "enumDescriptions": [
                            "Keep the line endings the file is already saved with (recommended)",
                            "\\n only (Linux / macOS)",
                            "\\r\\n (Windows)",
                            "\\r only (rare)"
                        ],
                        "description": "Line ending style — Prettier endOfLine"
                    },
                    "classicAsp.prettier.htmlWhitespaceSensitivity": {
                        "type": "string",
                        "default": "css",
                        "enum": [
                            "css",
                            "strict",
                            "ignore"
                        ],
                        "enumDescriptions": [
                            "Follow the CSS display property for whitespace decisions",
                            "All whitespace is significant",
                            "All whitespace is insignificant"
                        ],
                        "description": "HTML whitespace sensitivity — Prettier htmlWhitespaceSensitivity"
                    }
                }
            },
            {
                "title": "Syntax Highlighting",
                "properties": {
                    "classicAsp.highlightAspRegions": {
                        "type": "boolean",
                        "default": true,
                        "description": "Highlight ASP code regions with background colors"
                    },
                    "classicAsp.bracketLightColor": {
                        "type": "string",
                        "default": "rgba(255, 100, 0, 0.15)",
                        "description": "ASP bracket <% %> color (light theme)"
                    },
                    "classicAsp.bracketDarkColor": {
                        "type": "string",
                        "default": "rgba(0, 100, 255, 0.15)",
                        "description": "ASP bracket <% %> color (dark theme)"
                    },
                    "classicAsp.codeBlockLightColor": {
                        "type": "string",
                        "default": "rgba(100, 100, 100, 0.04)",
                        "description": "ASP code block background (light theme)"
                    },
                    "classicAsp.codeBlockDarkColor": {
                        "type": "string",
                        "default": "rgba(220, 220, 220, 0.04)",
                        "description": "ASP code block background (dark theme)"
                    }
                }
            },
            {
                "title": "Old names (moved to classicAsp)",
                "properties": {
                    "aspLanguageSupport.keywordCase": {
                        "type": "string",
                        "enum": [
                            "lowercase",
                            "UPPERCASE",
                            "PascalCase"
                        ],
                        "deprecationMessage": "Renamed to classicAsp.keywordCase. Your value is moved there automatically."
                    },
                    "aspLanguageSupport.aspTagsOnSameLine": {
                        "type": "boolean",
                        "deprecationMessage": "Renamed to classicAsp.aspTagsOnSameLine. Your value is moved there automatically."
                    },
                    "aspLanguageSupport.htmlIndentMode": {
                        "type": "string",
                        "enum": [
                            "flat",
                            "continuation"
                        ],
                        "deprecationMessage": "Renamed to classicAsp.htmlIndentMode. Your value is moved there automatically."
                    },
                    "aspLanguageSupport.virtualRoot": {
                        "type": "string",
                        "deprecationMessage": "Renamed to classicAsp.virtualRoot. Your value is moved there automatically."
                    },
                    "aspLanguageSupport.defaultIncludes": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "deprecationMessage": "Renamed to classicAsp.defaultIncludes. Your value is moved there automatically."
                    },
                    "aspLanguageSupport.prettier.printWidth": {
                        "type": "number",
                        "deprecationMessage": "Renamed to classicAsp.prettier.printWidth. Your value is moved there automatically."
                    },
                    "aspLanguageSupport.prettier.tabWidth": {
                        "type": "number",
                        "enum": [
                            2,
                            4,
                            8
                        ],
                        "deprecationMessage": "Renamed to classicAsp.prettier.tabWidth. Your value is moved there automatically."
                    },
                    "aspLanguageSupport.prettier.useTabs": {
                        "type": "boolean",
                        "deprecationMessage": "Renamed to classicAsp.prettier.useTabs. Your value is moved there automatically."
                    },
                    "aspLanguageSupport.prettier.bracketSameLine": {
                        "type": "boolean",
                        "deprecationMessage": "Renamed to classicAsp.prettier.bracketSameLine. Your value is moved there automatically."
                    },
                    "aspLanguageSupport.prettier.semi": {
                        "type": "boolean",
                        "deprecationMessage": "Renamed to classicAsp.prettier.semi. Your value is moved there automatically."
                    },
                    "aspLanguageSupport.prettier.singleQuote": {
                        "type": "boolean",
                        "deprecationMessage": "Renamed to classicAsp.prettier.singleQuote. Your value is moved there automatically."
                    },
                    "aspLanguageSupport.prettier.arrowParens": {
                        "type": "string",
                        "enum": [
                            "always",
                            "avoid"
                        ],
                        "deprecationMessage": "Renamed to classicAsp.prettier.arrowParens. Your value is moved there automatically."
                    },
                    "aspLanguageSupport.prettier.trailingComma": {
                        "type": "string",
                        "enum": [
                            "none",
                            "es5",
                            "all"
                        ],
                        "deprecationMessage": "Renamed to classicAsp.prettier.trailingComma. Your value is moved there automatically."
                    },
                    "aspLanguageSupport.prettier.endOfLine": {
                        "type": "string",
                        "enum": [
                            "auto",
                            "lf",
                            "crlf",
                            "cr"
                        ],
                        "deprecationMessage": "Renamed to classicAsp.prettier.endOfLine. Your value is moved there automatically."
                    },
                    "aspLanguageSupport.prettier.htmlWhitespaceSensitivity": {
                        "type": "string",
                        "enum": [
                            "css",
                            "strict",
                            "ignore"
                        ],
                        "deprecationMessage": "Renamed to classicAsp.prettier.htmlWhitespaceSensitivity. Your value is moved there automatically."
                    },
                    "aspLanguageSupport.highlightAspRegions": {
                        "type": "boolean",
                        "deprecationMessage": "Renamed to classicAsp.highlightAspRegions. Your value is moved there automatically."
                    },
                    "aspLanguageSupport.bracketLightColor": {
                        "type": "string",
                        "deprecationMessage": "Renamed to classicAsp.bracketLightColor. Your value is moved there automatically."
                    },
                    "aspLanguageSupport.bracketDarkColor": {
                        "type": "string",
                        "deprecationMessage": "Renamed to classicAsp.bracketDarkColor. Your value is moved there automatically."
                    },
                    "aspLanguageSupport.codeBlockLightColor": {
                        "type": "string",
                        "deprecationMessage": "Renamed to classicAsp.codeBlockLightColor. Your value is moved there automatically."
                    },
                    "aspLanguageSupport.codeBlockDarkColor": {
                        "type": "string",
                        "deprecationMessage": "Renamed to classicAsp.codeBlockDarkColor. Your value is moved there automatically."
                    }
                }
            }
        ],
        "configurationDefaults": {
            "[asp]": {
                "editor.wordBasedSuggestions": "off"
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "clean": "node -e \"require('fs').rmSync('out', { recursive: true, force: true })\"",
        "gen-types": "node scripts/generate-dom-types.js",
        "compile": "npm run clean && npm run gen-types && tsc -p ./ && npm run sync-grammar",
        "sync-grammar": "node scripts/sync-grammar-keywords.js",
        "watch": "node scripts/watch.js",
        "watch-types": "node scripts/generate-dom-types.js --watch",
        "pretest": "npm run compile && npm run lint",
        "lint": "eslint src",
        "test": "mocha",
        "test:unit": "npm run compile && mocha",
        "test:integration": "npm run compile && vscode-test"
    },
    "dependencies": {
        "@vscode/emmet-helper": "^2.11.0",
        "prettier": "^3.8.1",
        "typescript": "^5.9.3",
        "vscode-css-languageservice": "^6.3.9",
        "vscode-html-languageservice": "^5.6.2",
        "vscode-languageserver-textdocument": "^1.0.12"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.10",
        "@types/node": "^20.0.0",
        "@types/vscode": "^1.80.0",
        "@typescript-eslint/eslint-plugin": "^8.53.1",
        "@typescript-eslint/parser": "^8.53.1",
        "@vscode/test-cli": "^0.0.15",
        "@vscode/test-electron": "^3.0.0",
        "eslint": "^8.41.0",
        "mocha": "^11.7.6"
    }
}
